VIGIL_ENV=development
VIGIL_LOG_LEVEL=info
VIGIL_LOG_FORMAT=text
VIGIL_HTTP_ADDR=:8080
VIGIL_SHUTDOWN_TIMEOUT=35s
VIGIL_WORKER_CONCURRENCY=5
VIGIL_WORKER_POLL_INTERVAL=1s
VIGIL_WORKER_HTTP_ADDR=:9090
VIGIL_WORKER_LEASE_DURATION=45s
VIGIL_DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil?sslmode=disable
VIGIL_DATABASE_MAX_CONNS=10
VIGIL_DATABASE_MIN_CONNS=1
VIGIL_DATABASE_CONNECT_TIMEOUT=5s

# Integration tests refuse databases whose name does not end in _test.
VIGIL_TEST_DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil_test?sslmode=disable
