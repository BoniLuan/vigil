# Use an immutable release tag or digest in production.
VIGIL_IMAGE=ghcr.io/boniluan/vigil:v0.1.0
VIGIL_VERSION=0.1.0
VIGIL_COMMIT=replace-with-git-sha
VIGIL_BUILD_DATE=2026-09-02T00:00:00Z
VIGIL_API_PORT=8080
VIGIL_LOG_LEVEL=info
VIGIL_DATABASE_URL=postgres://vigil:replace-with-url-escaped-password@postgres:5432/vigil?sslmode=disable
VIGIL_DATABASE_MAX_CONNS=10
VIGIL_DATABASE_MIN_CONNS=1
VIGIL_DATABASE_CONNECT_TIMEOUT=5s
VIGIL_SHUTDOWN_TIMEOUT=35s
VIGIL_WORKER_CONCURRENCY=5
VIGIL_WORKER_POLL_INTERVAL=1s
VIGIL_WORKER_LEASE_DURATION=45s
POSTGRES_DB=vigil
POSTGRES_USER=vigil
POSTGRES_PASSWORD=replace-with-long-random-password
