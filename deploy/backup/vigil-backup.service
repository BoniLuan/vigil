[Unit]
Description=Create and validate a Vigil PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=luan
Group=luan
Environment=VIGIL_BACKUP_DIR=/home/luan/.config/vigil/backups
Environment=VIGIL_POSTGRES_CONTAINER=vigil-postgres-1
Environment=VIGIL_BACKUP_RETENTION_DAYS=30
ExecStart=/home/luan/projects/vigil/deploy/backup/vigil-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/luan/.config/vigil/backups
